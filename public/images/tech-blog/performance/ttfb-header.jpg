<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <!-- Background Gradients -->
    <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0d1021"/>
      <stop offset="50%" stop-color="#151936"/>
      <stop offset="100%" stop-color="#0f1526"/>
    </linearGradient>

    <radialGradient id="purple-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2c2466" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#151936" stop-opacity="0"/>
    </radialGradient>

    <!-- Text Gradient -->
    <linearGradient id="title-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#8be9fd"/>
      <stop offset="45%" stop-color="#dbf4ff"/>
      <stop offset="100%" stop-color="#ffffff"/>
    </linearGradient>

    <!-- Waterfall Bar Gradients -->
    <linearGradient id="bar-redirect" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#5c6684"/>
      <stop offset="100%" stop-color="#6e7999"/>
    </linearGradient>
    <linearGradient id="bar-sw" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2d8685"/>
      <stop offset="100%" stop-color="#379e9c"/>
    </linearGradient>
    <linearGradient id="bar-dns" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2ab4f7"/>
      <stop offset="100%" stop-color="#45c4ff"/>
    </linearGradient>
    <linearGradient id="bar-tcp" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#5e64ff"/>
      <stop offset="100%" stop-color="#767bff"/>
    </linearGradient>
    <linearGradient id="bar-tls" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a248f5"/>
      <stop offset="100%" stop-color="#b666ff"/>
    </linearGradient>
    <linearGradient id="bar-wait" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f74f68"/>
      <stop offset="100%" stop-color="#ff667d"/>
    </linearGradient>
    <linearGradient id="bar-dl" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6d7193"/>
      <stop offset="100%" stop-color="#7c80a4"/>
    </linearGradient>

    <!-- Glow Filters -->
    <filter id="glow-blue" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
    <filter id="glow-cyan-line" x="-400%" y="-10%" width="900%" height="120%">
      <feGaussianBlur stdDeviation="4" result="blur1"/>
      <feGaussianBlur stdDeviation="8" result="blur2"/>
      <feMerge>
        <feMergeNode in="blur2"/>
        <feMergeNode in="blur1"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="glow-green" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#19b36b" flood-opacity="0.35"/>
    </filter>
    <filter id="glow-amber" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#d4953b" flood-opacity="0.3"/>
    </filter>
    <filter id="glow-red" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#d94052" flood-opacity="0.3"/>
    </filter>
    <filter id="card-shadow" x="-10%" y="-10%" width="120%" height="125%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#050711" flood-opacity="0.65"/>
    </filter>

    <!-- Background Grid Pattern -->
    <pattern id="bg-grid" width="150" height="150" patternUnits="userSpaceOnUse">
      <path d="M 150 0 L 0 0 0 150" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.03"/>
    </pattern>
  </defs>

  <!-- Main Background -->
  <rect width="1200" height="675" rx="20" fill="url(#bg-grad)"/>
  <rect width="1200" height="675" rx="20" fill="url(#bg-grid)"/>

  <!-- Ambient Glow & Decorative Circles -->
  <circle cx="950" cy="180" r="350" fill="url(#purple-glow)"/>
  <circle cx="245" cy="240" r="175" fill="#1b264f" fill-opacity="0.55"/>
  <circle cx="955" cy="485" r="220" fill="#13253c" fill-opacity="0.6"/>

  <!-- ================= LEFT COLUMN ================= -->
  <g transform="translate(80, 0)">
    <!-- Pill Badge -->
    <rect x="0" y="96" width="308" height="44" rx="22" fill="#162244" fill-opacity="0.85" stroke="#2c4982" stroke-width="1.5"/>
    <circle cx="22" cy="118" r="6" fill="#2ea8ff" filter="url(#glow-blue)"/>
    <text x="38" y="124" fill="#e2e8f0" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="16.5" font-weight="700" letter-spacing="0.8">WEB PERFORMANCE METRIC</text>

    <!-- Main Heading -->
    <text x="0" y="200" fill="url(#title-grad)" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="64" font-weight="800" letter-spacing="-0.5">(TTFB)</text>
    <text x="0" y="270" fill="url(#title-grad)" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="64" font-weight="800" letter-spacing="-0.5">Time to First </text>
    <text x="0" y="340" fill="url(#title-grad)" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="64" font-weight="800" letter-spacing="-0.5">Byte</text>

    <!-- Subtitle -->
    <text x="0" y="390" fill="#8e9bb0" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="27" font-weight="400">From Navigation Start to the First</text>
    <text x="0" y="428" fill="#8e9bb0" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="27" font-weight="400">Byte of Response</text>

    <!-- Threshold Badges -->
    <!-- Good -->
    <g transform="translate(0, 466)">
      <rect x="0" y="0" width="118" height="50" rx="10" fill="#11483b" fill-opacity="0.75" stroke="#1cb870" stroke-width="1.5" filter="url(#glow-green)"/>
      <text x="59" y="31" text-anchor="middle" fill="#2fe08d" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="21" font-weight="600">Good</text>
      <text x="59" y="82" text-anchor="middle" fill="#8e9bb0" font-family="'JetBrains Mono', 'Fira Code', 'Courier New', monospace" font-size="21" font-weight="500">&#8804; 800ms</text>
    </g>

    <!-- Needs Improvement -->
    <g transform="translate(135, 466)">
      <rect x="0" y="0" width="218" height="50" rx="10" fill="#473623" fill-opacity="0.75" stroke="#d4953b" stroke-width="1.5" filter="url(#glow-amber)"/>
      <text x="109" y="31" text-anchor="middle" fill="#f5b04c" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="21" font-weight="600">Needs Improvement</text>
      <text x="109" y="82" text-anchor="middle" fill="#8e9bb0" font-family="'JetBrains Mono', 'Fira Code', 'Courier New', monospace" font-size="21" font-weight="500">800ms-1800ms</text>
    </g>

    <!-- Poor -->
    <g transform="translate(370, 466)">
      <rect x="0" y="0" width="122" height="50" rx="10" fill="#4c202e" fill-opacity="0.75" stroke="#cf3c4f" stroke-width="1.5" filter="url(#glow-red)"/>
      <text x="61" y="31" text-anchor="middle" fill="#f2576b" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="21" font-weight="600">Poor</text>
      <text x="61" y="82" text-anchor="middle" fill="#8e9bb0" font-family="'JetBrains Mono', 'Fira Code', 'Courier New', monospace" font-size="21" font-weight="500">&gt; 1800ms</text>
    </g>
  </g>

  <!-- ================= RIGHT COLUMN (WATERFALL WINDOW) ================= -->
  <g transform="translate(615, 92)" filter="url(#card-shadow)">
    <!-- Window Body -->
    <rect x="0" y="0" width="504" height="482" rx="14" fill="#1a2230" stroke="#2d3748" stroke-width="2"/>
    
    <!-- Window Top Bar -->
    <path d="M 0 14 Q 0 0 14 0 L 490 0 Q 504 0 504 14 L 504 44 L 0 44 Z" fill="#131926"/>
    <line x1="0" y1="44" x2="504" y2="44" stroke="#263042" stroke-width="1"/>

    <!-- Mac Window Controls -->
    <circle cx="25" cy="22" r="6.5" fill="#f25252"/>
    <circle cx="45" cy="22" r="6.5" fill="#f5a623"/>
    <circle cx="65" cy="22" r="6.5" fill="#27c93f"/>

    <!-- Top Axis Labels -->
    <text x="178" y="73" text-anchor="middle" fill="#7c889b" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="14.5">startTime (0ms)</text>
    <text x="403" y="73" text-anchor="middle" fill="#4fd1ff" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="14.5" font-weight="500">responseStart (First Byte)</text>

    <!-- Vertical Dashed Grid Lines -->
    <g stroke="#334155" stroke-width="1" stroke-dasharray="3,3">
      <line x1="178" y1="84" x2="178" y2="365"/>
      <line x1="229" y1="84" x2="229" y2="365"/>
      <line x1="279" y1="84" x2="279" y2="365"/>
      <line x1="330" y1="84" x2="330" y2="365"/>
      <line x1="454" y1="84" x2="454" y2="365"/>
      <line x1="484" y1="84" x2="484" y2="365"/>
    </g>

    <!-- Stage Labels (Left Aligned to Vertical Axis) -->
    <g font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="15.5" text-anchor="end">
      <text x="168" y="116" fill="#cbd5e1">Redirect</text>
      <text x="168" y="154" fill="#cbd5e1">Service Worker / Cache</text>
      <text x="168" y="192" fill="#cbd5e1">DNS Lookup</text>
      <text x="168" y="230" fill="#cbd5e1">TCP Handshake</text>
      <text x="168" y="268" fill="#cbd5e1">TLS Handshake</text>
      <text x="168" y="306" fill="#cbd5e1">Request &amp; Server Waiting</text>
      <text x="168" y="344" fill="#64748b">Content Download</text>
    </g>

    <!-- Waterfall Bars -->
    <!-- 1. Redirect -->
    <rect x="178" y="100" width="36" height="22" rx="4" fill="url(#bar-redirect)"/>
    <!-- 2. Service Worker / Cache -->
    <rect x="178" y="138" width="51" height="22" rx="4" fill="url(#bar-sw)"/>
    <!-- 3. DNS Lookup -->
    <rect x="183" y="176" width="46" height="22" rx="4" fill="url(#bar-dns)"/>
    <!-- 4. TCP Handshake -->
    <rect x="229" y="214" width="50" height="22" rx="4" fill="url(#bar-tcp)"/>
    <!-- 5. TLS Handshake -->
    <rect x="279" y="252" width="51" height="22" rx="4" fill="url(#bar-tls)"/>
    <!-- 6. Request & Server Waiting -->
    <rect x="330" y="290" width="73" height="22" rx="4" fill="url(#bar-wait)"/>
    <!-- 7. Content Download -->
    <rect x="403" y="328" width="81" height="22" rx="4" fill="url(#bar-dl)" fill-opacity="0.75"/>

    <!-- Glowing Vertical Cyan Line (responseStart Marker) -->
    <line x1="403" y1="84" x2="403" y2="365" stroke="#22e5ff" stroke-width="2" stroke-dasharray="4,3" filter="url(#glow-cyan-line)"/>

    <!-- Total TTFB Measurement Bracket -->
    <g stroke="#7dd3fc" stroke-width="1.5">
      <line x1="178" y1="382" x2="403" y2="382"/>
      <line x1="178" y1="374" x2="178" y2="390"/>
      <line x1="403" y1="374" x2="403" y2="390"/>
    </g>

    <!-- Formula Text -->
    <text x="290.5" y="408" text-anchor="middle" fill="#93c5fd" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="500">Total TTFB = responseStart - startTime</text>

    <!-- Bottom Pill Badge [ TTFB MEASURED ] -->
    <rect x="210" y="430" width="160" height="32" rx="6" fill="#151c28" stroke="#384b6b" stroke-width="1.2"/>
    <text x="290" y="451" text-anchor="middle" fill="#93c5fd" font-family="'JetBrains Mono', 'Fira Code', 'Courier New', monospace" font-size="14" font-weight="500" letter-spacing="1">[ TTFB MEASURED ]</text>
  </g>
</svg>
